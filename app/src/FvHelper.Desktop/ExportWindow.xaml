<Window x:Class="FvHelper.Desktop.ExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导出（含版本信息）"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F5F6F8"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        Foreground="#1F2329">

    <StackPanel Margin="20">
        <TextBlock Text="导出内容" FontWeight="SemiBold" Margin="0,0,0,8" />
        <TextBlock TextWrapping="Wrap" Foreground="#5A6069" LineHeight="22" Margin="0,0,0,14"
                   Text="会导出选中的那次提交的文件，以及版本信息（隐藏文件，资源管理器里看不到）。对方用本软件打开这个文件夹后，能继续查看历史、编辑并提交。" />

        <CheckBox x:Name="NewStartCheckBox" Content="作为新起点（只保留这一版，不带更早的历史）"
                  Margin="0,0,0,6" />
        <TextBlock TextWrapping="Wrap" Foreground="#8A9099" FontSize="12" LineHeight="20" Margin="20,0,0,18"
                   Text="勾选后导出的副本是一个全新项目：版本号从 rev 1 开始，所有文件记为新增，与原来的项目互不影响。" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" IsCancel="True" Style="{StaticResource SecondaryButton}" Padding="16,6" />
            <Button Content="选择目录并导出" IsDefault="True" Click="OnConfirm" Margin="10,0,0,0"
                    Style="{StaticResource PrimaryButton}" Padding="16,6" />
        </StackPanel>
    </StackPanel>
</Window>
