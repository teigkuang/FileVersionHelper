<Window x:Class="FvHelper.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FVHelper 文件版本管理器"
        Icon="Assets/FvHelper.ico"
        Height="760" Width="1180"
        MinWidth="1080" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6F8"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        Foreground="#1F2329"
        AllowDrop="True" DragOver="OnWindowDragOver" Drop="OnWindowDrop"
        PreviewKeyDown="OnPreviewKeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶栏 -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E6E8EB" BorderThickness="0,0,0,1" Padding="16,10">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" x:Name="SettingsButton" Content="设置" Click="OnOpenSettings"
                        Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" Padding="12,4"
                        ToolTip="版本信息署名等设置" />
                <TextBlock DockPanel.Dock="Right" x:Name="AuthorText" Text="版本信息署名 —" Foreground="#8A9099"
                           VerticalAlignment="Center" FontSize="12" Margin="0,0,14,0" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="FVHelper" FontSize="15" FontWeight="SemiBold" Margin="0,0,12,0" />
                    <TextBlock x:Name="PathText" Text="未选择项目" Foreground="#8A9099" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 三栏（两条可拖拽分栏线） -->
        <Grid Grid.Row="1" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" MinWidth="190" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" MinWidth="420" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="220" MinWidth="170" />
            </Grid.ColumnDefinitions>

            <!-- 左：项目列表 -->
            <Border Grid.Column="0" Background="#FFFFFF" CornerRadius="8" BorderBrush="#E6E8EB" BorderThickness="1" Margin="0,0,4,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="12,10,8,8" LastChildFill="True">
                        <Button DockPanel.Dock="Right" x:Name="AddProjectButton" Content="＋" Width="26" Height="26"
                                Click="OnAddProject" ToolTip="添加项目（选择一个文件夹，Ctrl+O）"
                                Style="{StaticResource SecondaryButton}" Padding="0" />
                        <Button DockPanel.Dock="Right" x:Name="RemoveProjectButton" Content="－" Width="26" Height="26"
                                Click="OnRemoveProject" ToolTip="从列表移除选中的项目（不删文件）"
                                Style="{StaticResource SecondaryButton}" Padding="0" Margin="0,0,6,0" />
                        <TextBlock Text="项目" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>

                    <ListBox Grid.Row="1" x:Name="ProjectList" BorderThickness="0" Background="Transparent"
                             Margin="6,0,6,4" SelectionChanged="OnProjectSelectionChanged"
                             ItemContainerStyle="{StaticResource NavItemStyle}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel MaxWidth="190">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Path}" Foreground="#8A9099" FontSize="11"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding LastCommit}" Foreground="{Binding LastCommitBrush}" FontSize="11"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Grid.Row="2" Margin="14,0,14,10" Foreground="#B0B6BE" FontSize="11" TextWrapping="Wrap"
                               Text="＋ 添加项目：选择论文文件夹（已带版本信息的会直接读出历史，全新的空文件夹也行），也可以直接把文件夹拖进窗口。要改名点中栏标题旁的「重命名」，要移除点上面的「－」" />
                </Grid>
            </Border>

            <!-- 左｜中 分栏线 -->
            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                          Cursor="SizeWE" />

            <!-- 中：项目文件 / 提交详情（两态切换） -->
            <Border Grid.Column="2" Background="#FFFFFF" CornerRadius="8" BorderBrush="#E6E8EB" BorderThickness="1" Margin="0,0,4,0">
                <Grid>

                    <!-- 态 A：项目文件列表 -->
                    <Grid x:Name="ProjectPanel">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="16,14,16,0" LastChildFill="True">
                            <Button DockPanel.Dock="Right" x:Name="ScanButton" Content="重新扫描"
                                    Click="OnRescan" ToolTip="重新扫描该项目文件夹，看有没有新改动"
                                    Style="{StaticResource SecondaryButton}" />
                            <Button DockPanel.Dock="Right" x:Name="OpenFolderButton" Content="打开文件目录" Margin="0,0,8,0"
                                    Click="OnOpenProjectFolder" ToolTip="在资源管理器里打开这个项目的文件夹"
                                    Style="{StaticResource SecondaryButton}" />
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="ProjectTitle" Text="（未选择项目）" FontSize="15" FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <Button x:Name="RenameProjectButton" Content="重命名" Margin="8,0,0,0"
                                            Click="OnRenameProject" VerticalAlignment="Center"
                                            ToolTip="改这个项目在列表里显示的名字（不改文件夹名，也不动文件）"
                                            Style="{StaticResource SecondaryButton}" Padding="8,1" FontSize="11" />
                                </StackPanel>
                                <TextBlock x:Name="ScanStatus" Text="选择左侧项目后显示文件" Foreground="#8A9099" FontSize="12" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>

                        <!-- 变更提示条（扫描发现变化时出现）：右侧是全选 / 全不选 -->
                        <Border Grid.Row="1" x:Name="ChangedBar" Background="#FFF8E6" BorderBrush="#F3D9A4" BorderThickness="1"
                                CornerRadius="6" Margin="16,12,16,0" Padding="12,8" Visibility="Collapsed">
                            <DockPanel LastChildFill="True">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <Button x:Name="SelectAllButton" Content="全选" Click="OnSelectAllChanges"
                                            Style="{StaticResource SecondaryButton}" Padding="8,2" FontSize="12" />
                                    <Button x:Name="SelectNoneButton" Content="全不选" Click="OnSelectNoChanges"
                                            Style="{StaticResource SecondaryButton}" Padding="8,2" FontSize="12" Margin="6,0,0,0" />
                                </StackPanel>
                                <TextBlock x:Name="ChangedText" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </DockPanel>
                        </Border>

                        <!-- 整库自检条（四态：OK / WARN / MISMATCH / CORRUPT） -->
                        <Border Grid.Row="2" x:Name="WholeIntegrityBar" Background="#F0F7F2" BorderBrush="#CBE4D6"
                                BorderThickness="1" CornerRadius="6" Margin="16,8,16,0" Padding="12,7" Visibility="Collapsed">
                            <TextBlock x:Name="WholeIntegrityText" Foreground="#2FA36B" FontSize="12" TextWrapping="Wrap"
                                       Text="✓ 版本信息自检通过" />
                        </Border>

                        <ListView Grid.Row="3" x:Name="FileListView" Margin="16,10,16,0" BorderThickness="0" Background="Transparent"
                                  ItemContainerStyle="{StaticResource FileRowStyle}">
                            <ListView.View>
                                <GridView ColumnHeaderContainerStyle="{StaticResource GridHeaderStyle}">
                                    <GridViewColumn Header="" Width="32">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=OneWay}" VerticalAlignment="Center"
                                                          Checked="OnChangeCheckToggled" Unchecked="OnChangeCheckToggled"
                                                          Visibility="{Binding IsChanged, Converter={StaticResource BoolToVis}}"
                                                          HorizontalAlignment="Center" ToolTip="勾上才会随这次提交一起提交" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="文件" Width="230" DisplayMemberBinding="{Binding Name}" />
                                    <GridViewColumn Header="状态" Width="70">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="大小" Width="80" DisplayMemberBinding="{Binding Size}" />
                                    <GridViewColumn Header="修改时间" Width="140" DisplayMemberBinding="{Binding Time}" />
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <!-- 空态引导 -->
                        <TextBlock Grid.Row="3" x:Name="EmptyHint" Visibility="Collapsed" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" Foreground="#8A9099" TextWrapping="Wrap" TextAlignment="Center"
                                   MaxWidth="320" LineHeight="24" />

                        <!-- 底部：提交标题 + 提交按钮（点提交会弹出「提交新版本」确认窗，可填标题与详情） -->
                        <Border Grid.Row="4" Background="#FAFBFC" BorderBrush="#E6E8EB" BorderThickness="0,1,0,0" Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="CommitMessageBox"
                                         Text="填写本次修改标题，例如：按导师意见改结论与图表编号"
                                         Foreground="#8A9099" BorderBrush="#E6E8EB" Padding="8,6"
                                         VerticalContentAlignment="Center"
                                         GotFocus="OnCommitMessageGotFocus" LostFocus="OnCommitMessageLostFocus"
                                         TextChanged="OnCommitMessageChanged" />
                                <Button Grid.Column="1" x:Name="CommitButton" Content="提交新版本" Margin="12,0,0,0" IsEnabled="False"
                                        Padding="16,8" Style="{StaticResource PrimaryButton}" Click="OnCommit"
                                        ToolTip="先填标题，再提交" />
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- 态 B：changelist 条目详情 + 导出 -->
                    <Grid x:Name="CommitPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="16,14,16,0" LastChildFill="True">
                            <Button DockPanel.Dock="Right" Content="返回文件列表" Click="OnBackToProject"
                                    Style="{StaticResource SecondaryButton}" />
                            <Button DockPanel.Dock="Right" x:Name="VerifyCommitButton" Content="重新校验" Click="OnVerifyCommit"
                                    Margin="0,0,8,0" Style="{StaticResource SecondaryButton}" />
                            <StackPanel>
                                <TextBlock x:Name="CommitTitle" FontSize="15" FontWeight="SemiBold" Text="rev 3" />
                                <TextBlock x:Name="CommitMeta" Foreground="#8A9099" FontSize="12" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>

                        <Border Grid.Row="1" x:Name="IntegrityBar" Background="#F0F7F2" BorderBrush="#CBE4D6" BorderThickness="1" CornerRadius="6"
                                Margin="16,12,16,0" Padding="12,8">
                            <TextBlock x:Name="IntegrityText" Foreground="#2FA36B" TextWrapping="Wrap"
                                       Text="✓ 已校验：该版本记录的文件与版本信息一致（文件数、哈希全部匹配）" />
                        </Border>

                        <ListView Grid.Row="2" x:Name="ChangeListView" Margin="16,10,16,0" BorderThickness="0" Background="Transparent"
                                  ItemContainerStyle="{StaticResource FileRowStyle}"
                                  MouseDoubleClick="OnChangeListDoubleClick">
                            <ListView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="在资源管理器中定位" Click="OnRevealSelectedChange" />
                                    <MenuItem Header="复制本次提交清单（Ctrl+C）" Click="OnCopyChangeList" />
                                </ContextMenu>
                            </ListView.ContextMenu>
                            <ListView.View>
                                <GridView ColumnHeaderContainerStyle="{StaticResource GridHeaderStyle}">
                                    <GridViewColumn Header="动作" Width="60">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Action}" FontWeight="SemiBold" Foreground="{Binding ActionBrush}" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="文件" Width="320" DisplayMemberBinding="{Binding Name}" />
                                    <GridViewColumn Header="大小" Width="90" DisplayMemberBinding="{Binding Size}" />
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <!-- 版本详细信息（导出模块上方） -->
                        <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#E6E8EB" BorderThickness="0,1,0,0"
                                Padding="16,10" MaxHeight="200">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel>
                                    <TextBlock Text="版本详细信息" FontSize="12" FontWeight="SemiBold" Foreground="#5A6069"
                                               Margin="0,0,0,6" />
                                    <TextBlock x:Name="VersionTitleText" FontSize="13" FontWeight="SemiBold"
                                               TextWrapping="Wrap" Margin="0,0,0,4" />
                                    <TextBlock x:Name="VersionDetailText" FontSize="12" Foreground="#5A6069"
                                               TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,4" />
                                    <TextBlock x:Name="VersionFactsText" FontSize="12" Foreground="#8A9099"
                                               TextWrapping="Wrap" LineHeight="20" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <Border Grid.Row="4" Background="#FAFBFC" BorderBrush="#E6E8EB" BorderThickness="0,1,0,0" Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Foreground="#8A9099" FontSize="12" VerticalAlignment="Center"
                                           Margin="0,0,12,0" TextWrapping="Wrap"
                                           Text="导出后可把文件夹直接发给别人：对方用本软件打开即可继续查看、编辑并提交。" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="ExportFilesButton" Content="导出（仅文件）" Click="OnExportFiles"
                                            Style="{StaticResource SecondaryButton}" Padding="14,7"
                                            ToolTip="只导出这次提交的文件，不含版本信息" />
                                    <Button x:Name="ExportMetaButton" Content="导出（含版本信息）" Margin="8,0,0,0" Click="OnExportMeta"
                                            Style="{StaticResource PrimaryButton}" Padding="14,7"
                                            ToolTip="连同版本信息一起导出，对方可直接继续编辑并提交" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- 加载遮罩（长操作时显示，覆盖在中栏之上） -->
                    <Border x:Name="BusyOverlay" Grid.RowSpan="2" Background="#E6FFFFFF" Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ProgressBar x:Name="BusyBar" IsIndeterminate="True" Width="220" Height="6"
                                         Foreground="#3B72F6" Background="#EDF2FE" BorderThickness="0" />
                            <TextBlock x:Name="BusyText" Margin="0,10,0,0" Foreground="#8A9099" FontSize="12"
                                       HorizontalAlignment="Center" Text="正在处理…" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 中｜右 分栏线 -->
            <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                          Cursor="SizeWE" />

            <!-- 右：提交记录 -->
            <Border Grid.Column="4" Background="#FFFFFF" CornerRadius="8" BorderBrush="#E6E8EB" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="12,10,12,8">
                        <TextBlock x:Name="CommitCount" DockPanel.Dock="Right" Foreground="#8A9099" FontSize="11" />
                        <TextBlock Text="提交记录" FontWeight="SemiBold" />
                    </DockPanel>

                    <ListBox Grid.Row="1" x:Name="CommitList" BorderThickness="0" Background="Transparent"
                             Margin="6,0,6,4" SelectionChanged="OnCommitSelectionChanged"
                             ItemContainerStyle="{StaticResource NavItemStyle}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel MaxWidth="168">
                                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Time}" Foreground="#8A9099" FontSize="11" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Grid.Row="2" Margin="12,0,12,10" Foreground="#B0B6BE" FontSize="11" TextWrapping="Wrap"
                               Text="点某一条 → 中间显示该次提交的文件与说明，可导出当时的版本" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
