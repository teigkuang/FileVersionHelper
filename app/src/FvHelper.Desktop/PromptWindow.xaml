<Window x:Class="FvHelper.Desktop.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="重命名项目" Width="420" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="#F5F6F8" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13"
        SnapsToDevicePixels="True" UseLayoutRounding="True">
    <Border Margin="16" Background="#FFFFFF" BorderBrush="#E6E8EB" BorderThickness="1" CornerRadius="8" Padding="16">
        <StackPanel>
            <TextBlock x:Name="TitleText" Text="重命名项目" FontSize="15" FontWeight="SemiBold" Foreground="#1F2329" />
            <TextBlock x:Name="LabelText" Foreground="#8A9099" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
            <TextBox x:Name="ValueBox" Margin="0,12,0,0" Padding="8,6" BorderBrush="#E6E8EB" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="取消" Click="OnCancel" Padding="16,6" Margin="0,0,8,0"
                        Style="{StaticResource SecondaryButton}" />
                <Button Content="确定" Click="OnOk" Padding="16,6"
                        Style="{StaticResource PrimaryButton}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
