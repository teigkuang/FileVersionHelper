<Window x:Class="FvHelper.Desktop.ExportDoneWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="导出完成" Width="560" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="#F5F6F8" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13"
        SnapsToDevicePixels="True" UseLayoutRounding="True">
    <Border Margin="16" Background="#FFFFFF" BorderBrush="#E6E8EB" BorderThickness="1" CornerRadius="8" Padding="16">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="✓" FontSize="16" FontWeight="Bold" Foreground="#2FA36B" VerticalAlignment="Center" />
                <TextBlock Text="导出完成" FontSize="15" FontWeight="SemiBold" Foreground="#1F2329" Margin="8,0,0,0"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="ModeText" Foreground="#8A9099" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock x:Name="SummaryText" Foreground="#8A9099" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" />

            <TextBlock Text="导出位置（可整段复制）" Foreground="#8A9099" FontSize="11" Margin="0,14,0,4" />
            <TextBox x:Name="PathBox" IsReadOnly="True" Padding="8,6" BorderBrush="#E6E8EB"
                     Background="#FAFBFC" TextWrapping="Wrap" MaxHeight="90"
                     VerticalScrollBarVisibility="Auto" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="CopyButton" Content="复制路径" Click="OnCopy" Padding="14,6" Margin="0,0,8,0"
                        Style="{StaticResource SecondaryButton}" />
                <Button x:Name="RevealButton" Content="打开文件夹" Click="OnReveal" Padding="14,6" Margin="0,0,8,0"
                        Style="{StaticResource SecondaryButton}" />
                <Button Content="完成" Click="OnClose" Padding="18,6" IsDefault="True"
                        Style="{StaticResource PrimaryButton}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
