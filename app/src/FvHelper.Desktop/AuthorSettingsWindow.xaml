<Window x:Class="FvHelper.Desktop.AuthorSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Width="460" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="#F5F6F8" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13"
        SnapsToDevicePixels="True" UseLayoutRounding="True">
    <Border Margin="16" Background="#FFFFFF" BorderBrush="#E6E8EB" BorderThickness="1" CornerRadius="8" Padding="16">
        <StackPanel>
            <TextBlock Text="版本信息署名" FontSize="15" FontWeight="SemiBold" Foreground="#1F2329" />
            <TextBlock Text="每次提交都会在版本信息里记下这个名字，方便看出是谁改的。首次填写后会保存，之后可以在这里改。"
                       Foreground="#8A9099" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
            <TextBox x:Name="AuthorBox" Margin="0,12,0,0" Padding="8,6" BorderBrush="#E6E8EB" />

            <Border Margin="0,18,0,0" BorderBrush="#E6E8EB" BorderThickness="0,1,0,0" />

            <TextBlock Text="大文件提示" FontSize="15" FontWeight="SemiBold" Foreground="#1F2329" Margin="0,14,0,0" />
            <TextBlock Text="改动里有文件超过这个大小，扫描提示条会点名提示（不影响提交）。"
                       Foreground="#8A9099" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBox x:Name="LargeFileBox" Width="80" Padding="8,6" BorderBrush="#E6E8EB" TextAlignment="Right" />
                <TextBlock Text="MB" Foreground="#8A9099" VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>

            <Border Margin="0,18,0,0" BorderBrush="#E6E8EB" BorderThickness="0,1,0,0" />

            <TextBlock Text="导出默认项" FontSize="15" FontWeight="SemiBold" Foreground="#1F2329" Margin="0,14,0,0" />
            <CheckBox x:Name="NewStartCheckBox" Content="导出（含版本信息）时默认勾选「作为新起点」"
                      Margin="0,10,0,0" />

            <Border Margin="0,18,0,0" BorderBrush="#E6E8EB" BorderThickness="0,1,0,0" />

            <TextBlock Text="当前项目的忽略规则（只读）" FontSize="12" Foreground="#8A9099" Margin="0,14,0,0" />

            <TextBlock x:Name="IgnoreText" Foreground="#5A6069" FontSize="12" TextWrapping="Wrap"
                       Margin="0,4,0,0" MaxHeight="80" />
            <TextBlock Text="忽略规则写在这个项目的版本信息文件里（隐藏），改动会改变已有数据的语义；目前只读展示，需要修改请告诉我单独做。"
                       Foreground="#B0B6BE" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />

            <TextBlock Text="保存位置：%LOCALAPPDATA%\FVHelper\settings.json（不写注册表）"
                       Foreground="#8A9099" FontSize="11" Margin="0,14,0,0" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="取消" Click="OnCancel" Padding="16,6" Margin="0,0,8,0"
                        Style="{StaticResource SecondaryButton}" />
                <Button Content="保存" Click="OnSave" Padding="16,6" IsDefault="True"
                        Style="{StaticResource PrimaryButton}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
