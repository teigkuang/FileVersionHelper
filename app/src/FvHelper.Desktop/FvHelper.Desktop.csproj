<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\FvHelper.Core\FvHelper.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\FvHelper.ico" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\FvHelper.ico</ApplicationIcon>
    <AssemblyName>FvHelper</AssemblyName>
    <RootNamespace>FvHelper.Desktop</RootNamespace>
  </PropertyGroup>

</Project>
